{
  "hosting": {
    "public": "portal",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/mcp",                                    "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } },
      { "source": "/mcp/**",                                 "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } },
      { "source": "/.well-known/oauth-protected-resource",   "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } },
      { "source": "/.well-known/oauth-authorization-server", "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } },
      { "source": "/auth/**",                                "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } },
      { "source": "/oauth/**",                               "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } },
      { "source": "/tools/**",                               "run": { "serviceId": "taxmann-mcp", "region": "asia-south1" } }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules", "target": "rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
