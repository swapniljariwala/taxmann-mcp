rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Users can only read/write their own usage data
    match /usage/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // OAuth collections are written exclusively by the server
    // (Firebase Admin SDK bypasses these rules). Deny all client access.
    match /auth_requests/{id} {
      allow read, write: if false;
    }

    match /auth_codes/{id} {
      allow read, write: if false;
    }

    match /sessions/{id} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
